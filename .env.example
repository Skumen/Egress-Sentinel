# Copy this file to .env and fill it in.

# Bot token from @BotFather
TELEGRAM_TOKEN=123456789:AAAA-your-token-here

# Telegram user IDs of the administrators (comma-separated). Required.
# Administrators approve access requests, manage exit nodes, press Acknowledge / Maintenance
# and receive service notices. To find your ID, send /myid to the bot.
ADMIN_IDS=123456789

# Optional: IDs of groups or channels that should also receive alerts (comma-separated).
# Empty: alerts go only to the users you approved, in private chats.
# Members of the listed groups get dashboard access without a request. Group ID: add the bot and send /chatid
CHAT_IDS=

# Public address of the Mini App (must be https://). Empty: the Mini App is disabled.
WEBAPP_URL=https://monitor.example.com

# Local port of the web server (Caddy or nginx proxies to it). Default 8080.
WEBAPP_PORT=8080

# Optional: short name of the app if you created one with /newapp in @BotFather.
# Group links then become https://t.me/<bot>/<name>, otherwise https://t.me/<bot>?startapp
WEBAPP_SHORT_NAME=

# 1 — do not send anything to Telegram, print messages to the console instead (debugging)
DRY_RUN=0
